# Copiar a .env, que está ignorado por git.
#   PowerShell:  Copy-Item .env.example .env

# --- API ---
PORT=3001

# Base de datos. Con docker compose, el host es el nombre del servicio.
MONGODB_URI=mongodb://localhost:27017/tienda

# --- Sesiones ---
# El secreto con el que se firman los tokens. Antes estaba escrito en el
# código como "secreto", lo cual significa que no era un secreto: cualquiera
# que leyera el repositorio podía firmar un token y hacerse pasar por
# cualquier usuario.
#
# Generá uno largo y al azar. En PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET=

# Cuánto dura una sesión.
JWT_EXPIRES_IN=1h
